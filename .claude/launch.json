{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/HakuTV.Api", "--launch-profile", "http"],
      "port": 5080,
      "url": "http://localhost:5080"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-test",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/HakuTV.Api", "-c", "Release", "--no-launch-profile", "--urls", "http://localhost:5081"],
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "port": 5081,
      "url": "http://localhost:5081"
    },
    {
      "name": "web-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174"],
      "env": { "HAKUTV_API": "http://localhost:5081" },
      "port": 5174
    }
  ]
}
